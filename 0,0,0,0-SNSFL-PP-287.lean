theorem dbt_step_is_dynamic_step (s : DBTState) (op : ℝ → ℝ) (F : ℝ) :
    dbt_step s op F = s.P + s.N + op s.B + s.A + F := by
  unfold dbt_step dynamic_rhs pnba_weight; ring

