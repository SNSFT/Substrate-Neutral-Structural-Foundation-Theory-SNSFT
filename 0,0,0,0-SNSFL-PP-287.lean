    discriminant a b c < 0 ∨
    discriminant a b c = 0 ∨
    discriminant a b c > 0 := by
  rcases lt_trichotomy (discriminant a b c) 0 with h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr h)

