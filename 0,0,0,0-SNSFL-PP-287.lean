noncomputable def resonance_score (obs tgt : ManifoldState) : ℝ :=
  (1 - (mode_distance obs.P tgt.P +
        mode_distance obs.N tgt.N +
        mode_distance obs.B tgt.B +
        mode_distance obs.A tgt.A) / 8) * 100

