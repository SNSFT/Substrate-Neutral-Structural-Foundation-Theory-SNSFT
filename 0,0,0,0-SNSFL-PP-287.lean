theorem emotion_step_is_dynamic_step (s : FEState) (op : ℝ → ℝ) (F : ℝ) :
    emotion_step s op F = s.P + s.N + op s.B + s.A + F := by
  unfold emotion_step dynamic_rhs pnba_weight; ring

