    is_malformed c → ¬ is_hypothesis c ∧ ¬ is_formally_verified c := by
  intro h
  refine ⟨?_, ?_⟩
  · intro h_hyp; exact h h_hyp.1
  · intro h_fv; exact h h_fv.1

