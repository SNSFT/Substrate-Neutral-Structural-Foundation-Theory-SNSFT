theorem large_signal_causes_shatter (s : PNBAState) (δ : ℝ)
    (hP : s.P > 0)
    (hLarge : (s.B + δ) / s.P ≥ TORSION_LIMIT) :
    shatter_event (f_ext_op s δ) :=
  ⟨hP, by unfold torsion f_ext_op; simp; exact hLarge⟩

