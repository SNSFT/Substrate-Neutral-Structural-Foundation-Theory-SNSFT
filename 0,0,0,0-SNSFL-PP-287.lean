-- Sustained, unconscious. This is how TMT actually works post-salience.
noncomputable def distal_defense (s : TMTState) (δP δA : ℝ)
    (hδP : δP > 0) (hδA : δA > 0) : TMTState :=
  { s with P := s.P + δP, A := s.A + δA,
           hP := by linarith [s.hP],
           hA := by linarith [s.hA] }

