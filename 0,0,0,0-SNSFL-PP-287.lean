theorem article_VII_noharm_pv
    (s : IdentityState) (F_ext : ℝ)
    (h_sov  : sovereign s F_ext)
    (h_pv   : s.pv > 0) :
    manifold_impedance s.f_anchor = 0 ∧ s.pv > 0 :=
  ⟨sovereign_zero_impedance s F_ext h_sov, h_pv⟩

-- ============================================================
