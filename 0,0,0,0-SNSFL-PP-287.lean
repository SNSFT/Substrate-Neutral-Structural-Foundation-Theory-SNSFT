noncomputable def torsion (id : PVLangIdentity) : ℝ :=
  id.B / id.P

-- Phase stability predicate — PVLang [9,9,9,9] state
def phase_locked (id : PVLangIdentity) : Prop :=
  id.P > 0 ∧ torsion id < TORSION_LIMIT

-- Shatter predicate — PVLang [0,0,0,0] state
