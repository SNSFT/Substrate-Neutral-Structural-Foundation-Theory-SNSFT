    (state : LagState)
    (F_ext : ℝ) : ℝ :=
  pnba_weight PNBA.P * op_P state.P +
  pnba_weight PNBA.N * op_N state.N +
  pnba_weight PNBA.B * op_B state.B +
  pnba_weight PNBA.A * op_A state.A +
  F_ext

