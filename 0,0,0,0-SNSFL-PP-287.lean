theorem true_lock_excludes_false_lock (s : PolyvagalState) :
    ¬ (true_lock s ∧ false_lock s) := by
  intro ⟨⟨_, _, hN_hi⟩, ⟨_, _, hN_lo⟩⟩; linarith

