-- LAYER 0 — PROCESSING STATE
-- ============================================================

structure ProcessingState where
  P        : ℝ  -- [P:PROC]  processing resolution / pattern lock
  N        : ℝ  -- [N:PROC]  narrative filtering / social cohesion
