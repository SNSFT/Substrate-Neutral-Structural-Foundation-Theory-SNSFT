theorem T5_b_balance_sub_lemma (M : ℕ) (hM : M ≥ 1) :
    (1 : ℚ) / (M + 1) + 1 / (M * (M + 1)) = 1 / M := by
  have hM' : (M : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hM1 : (M : ℚ) + 1 ≠ 0 := by positivity
  field_simp; ring

