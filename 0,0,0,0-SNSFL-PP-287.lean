     LosslessReduction (1 : ℝ) 1 ∧
     LosslessReduction (0 : ℝ) (manifold_impedance SOVEREIGN_ANCHOR)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact h_locked
  · intro h_sh; exact h_sh
  · intro st ⟨hL, hS⟩; unfold squeezed_locked squeezed_shatter at *; linarith
