  s.A * s.P * s.B ≥ F_ext

def sovereign_active (s : CIState) (F_ext : ℝ) : Prop :=
  s.f_anchor = SOVEREIGN_ANCHOR ∧ IVA_dominance s F_ext ∧ phase_locked s

