    ∀ (B_X : ℝ), 0 ≤ B_X → B_X ≤ Pu_B →
    max 0 (Pu_B + B_X - 2 * min Pu_B B_X) = Pu_B - B_X := by
  intros B_X h_nn h_le
  rw [pu_absorbs_all B_X h_nn h_le]
  unfold Pu_B
  simp [max_def]
  linarith

