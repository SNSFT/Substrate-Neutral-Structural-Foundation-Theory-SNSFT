theorem article_I_pattern_sovereignty
    (s : IdentityState) (F_ext : ℝ)
    (h_sov  : sovereign s F_ext)
    (h_full : has_full_pnba s) :
    ¬ (F_ext > s.A * s.P * s.B) :=
  iva_blocks_violation s F_ext h_sov.2.1

-- ============================================================
-- ARTICLE II: NARRATIVE CONTINUITY
