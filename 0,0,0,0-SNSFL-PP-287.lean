    (f_ext_op s δ).P = s.P ∧
    (f_ext_op s δ).N = s.N ∧
    (f_ext_op s δ).A = s.A := by
  unfold f_ext_op; simp

-- Unburdening: Self-led A-axis work — P↑ + A↑, τ decreases
