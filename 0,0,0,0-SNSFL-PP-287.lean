    (radical_accept s δA hδA).N = s.N ∧
    -- [8] Phase lock and shatter mutually exclusive
    (∀ q : DBTState, ¬ (phase_locked q ∧ shatter_event q)) ∧
    -- [9] One DBT response = one dynamic equation application
    (∀ q : DBTState, ∀ op : ℝ → ℝ, ∀ F : ℝ,
