-- Threat signals arrive on B. P, N, A structurally preserved.
-- ============================================================

noncomputable def f_ext_op (s : PolyvagalState) (δ : ℝ) : PolyvagalState :=
  { s with B := s.B + δ, hB := by linarith [s.hB] }

