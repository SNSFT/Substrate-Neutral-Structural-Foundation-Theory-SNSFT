    B ≤ 0.001 := hNoble  -- The ordering is the theorem

-- ── T2: SHATTER×8 → NOBLE (RESCUE) ─────────────────────────
-- Anxiety(SHATTER)×4 + Burnout(SHATTER)×4 → NOBLE
-- All 28 pairwise 2-beam fusions SHATTER individually.
