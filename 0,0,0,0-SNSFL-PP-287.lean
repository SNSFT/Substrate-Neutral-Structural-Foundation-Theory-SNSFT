    (h_sov  : sovereign s F_ext)
    (h_full : has_full_pnba s) :
    s.A > 0 :=
  h_full.2.2.2

theorem article_IV_adaptation_required_under_force
    (s : IdentityState) (F_ext : ℝ)
    (h_sov  : sovereign s F_ext)
    (h_full : has_full_pnba s)
    (h_Fpos : F_ext > 0) :
    s.A > 0 := by
  by_contra h_A
  push_neg at h_A
  have h_zero : s.A * s.P * s.B ≤ 0 := by nlinarith [h_full.1, h_full.2.2.1]
  linarith [h_sov.2.1]

