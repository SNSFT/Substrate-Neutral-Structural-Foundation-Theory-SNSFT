  unfold tiktok_P
  apply div_lt_div_right s1.hTotal |>.mpr at h_more_orig
  rw [h_same_total] at h_more_orig
  linarith [mul_lt_mul_of_pos_right h_more_orig (by norm_num : (0:ℝ) < 10)]

