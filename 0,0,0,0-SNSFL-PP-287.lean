theorem charge_quantization_unique :
    ∀ (Bu Bd : ℝ),
    Bu = 2 * Bd →           -- neutron neutrality
    2 * Bu - Bd = 1 →       -- proton charge = 1
    Bu = 2/3 ∧ Bd = 1/3 := by
  intros Bu Bd h_neutron h_proton
