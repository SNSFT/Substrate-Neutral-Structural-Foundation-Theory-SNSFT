    v_e * (1 + g_r) * Real.log (m₀ / m_f) > v_e * Real.log (m₀ / m_f) ∧
    -- [5] Lossless Soulprint: roundtrip-perfect
    decode_soul8 (encode_soulprint sp) = soulprint_weights sp ∧
