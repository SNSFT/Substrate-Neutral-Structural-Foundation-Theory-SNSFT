theorem dynamic_rhs_linear
    (op_P op_N op_B op_A : ℝ → ℝ)
    (s : KernelState) (F : ℝ) :
    dynamic_rhs op_P op_N op_B op_A s F =
    op_P s.P + op_N s.N + op_B s.B + op_A s.A + F := by
  unfold dynamic_rhs pnba_weight; ring

