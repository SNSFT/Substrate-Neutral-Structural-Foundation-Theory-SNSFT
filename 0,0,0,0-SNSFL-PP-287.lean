  intros X_P hX
  unfold F_P H_P
  have h1 : (5.2 + X_P) > 0 := by linarith
  have h2 : (1 + X_P) > 0 := by linarith
  rw [div_lt_div_iff (by linarith) (by linarith)]
  ring_nf
  nlinarith

