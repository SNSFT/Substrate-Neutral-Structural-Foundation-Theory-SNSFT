    ∀ (B1 B2 : ℝ), B_out B1 B2 1 = 0 ↔ B1 + B2 ≤ 2 := by
  intros B1 B2
  unfold B_out
  constructor
  · intro h
    by_contra hc
    push_neg at hc
    have : max 0 (B1 + B2 - 2 * 1) > 0 := by
      rw [max_def]; split_ifs with h2
      · linarith
      · push_neg at h2; linarith
    linarith [this.symm.trans_eq h]
  · intro h
    simp [max_eq_left]
    linarith

