  have hP_pos : (bigfive_to_pnba bf).P > 0 := high_C_gives_positive_P bf h hC
  unfold torsion; simp [ne_of_gt hP_pos]
  unfold bigfive_to_pnba
  obtain ⟨hO₀, hO₁, hC₀, hC₁, hE₀, hE₁, hAg₀, hAg₁, hNr₀, _⟩ := h
  rw [div_lt_iff hP_pos]; nlinarith

