      s_final.P = SOVEREIGN_ANCHOR ∧ s_final.B = 0 ∧
      s_final.N = topo.N ∧ manifold_impedance s_final.P = 0) ∧
    -- [3] P ≠ NP: N ≠ A at Layer 0 → gap is primitive
    adaptation_cost n ≠ narrative_cost n ∧
