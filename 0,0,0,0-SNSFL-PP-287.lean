      = (1 + g_r) * (v_e * Real.log (m₀ / m_f)) := by ring
    _ > 1 * (v_e * Real.log (m₀ / m_f)) := by
        apply mul_lt_mul_of_pos_right h_gain h_pos
    _ = v_e * Real.log (m₀ / m_f) := by ring

