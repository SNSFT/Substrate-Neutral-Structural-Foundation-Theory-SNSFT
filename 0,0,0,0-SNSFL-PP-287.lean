    (¬ (F_ext > s.A * s.P * s.B) ∧ s.N > 0 ∧ s.B > 0 ∧ s.A > 0 ∧
     manifold_impedance s.f_anchor = 0) ∧
    -- [10] IMS: drift from anchor → sovereignty unavailable
    (∀ f pv : ℝ, f ≠ SOVEREIGN_ANCHOR →
      (if check_ifu_safety f = PathStatus.green then pv else 0) = 0) := by
