-- ============================================================
-- LAYER 1 — TORSION LAW
-- ============================================================

noncomputable def torsion (s : ACTState) : ℝ := s.B / s.P

def phase_locked  (s : ACTState) : Prop := s.P > 0 ∧ torsion s < TORSION_LIMIT
def shatter_event (s : ACTState) : Prop := s.P > 0 ∧ torsion s ≥ TORSION_LIMIT

