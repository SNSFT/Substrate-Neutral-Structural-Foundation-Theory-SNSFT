      norm_num
    · unfold helplessness strong_external A_THRESHOLD
      push_neg; intro _ _; norm_num
  · -- [9] helplessness → shatter
    intro s ⟨hP, hτ, _⟩; exact ⟨hP, hτ⟩
  · -- [10] all examples lossless
