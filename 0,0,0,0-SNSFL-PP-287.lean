-- ============================================================

def IVA_dominance (s : InfoState) (F_ext : ℝ) : Prop :=
  s.A * s.P * s.B ≥ F_ext

def is_lossy (s : InfoState) (F_ext : ℝ) : Prop :=
  F_ext > s.A * s.P * s.B

-- F_ext changes B only — signal pressure, not structure
noncomputable def f_ext_op (s : InfoState) (δ : ℝ) : InfoState :=
  { s with B := s.B + δ }

-- ============================================================
