theorem act_is_lossless_pnba_projection
    (s : ACTState) (h_sync : s.f_anchor = SOVEREIGN_ANCHOR)
    (δA δN δP : ℝ) (hδA : δA > 0) (hδN : δN > 0) (hδP : δP > 0) :
