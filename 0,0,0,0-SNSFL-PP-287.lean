  (axis_flexed u.P_score ∧ axis_flexed u.N_score ∧ axis_flexed u.A_score ∧
   ¬ axis_flexed u.B_score) ∨
  (axis_flexed u.P_score ∧ axis_flexed u.N_score ∧ axis_flexed u.B_score ∧
