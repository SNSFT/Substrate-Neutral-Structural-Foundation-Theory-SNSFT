    (hδP : δP > 0) (hδA : δA > 0) :
    torsion (distal_defense s δP δA hδP hδA) < torsion s := by
  unfold torsion distal_defense; simp
  apply div_lt_div_of_pos_left s.hB s.hP; linarith

