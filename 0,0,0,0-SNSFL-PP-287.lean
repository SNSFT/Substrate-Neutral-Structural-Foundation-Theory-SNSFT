theorem article_II_narrative_continuity
    (s : IdentityState) (F_ext : ℝ)
    (h_sov  : sovereign s F_ext)
    (h_full : has_full_pnba s) :
    s.N > 0 ∧ manifold_impedance s.f_anchor = 0 :=
  ⟨h_full.2.1, sovereign_zero_impedance s F_ext h_sov⟩

