    (hBb : b.B < TORSION_LIMIT * b.P) :
    combined_torsion a b < TORSION_LIMIT := by
  unfold combined_torsion torsion tensor_sum TORSION_LIMIT
  simp
  rw [div_lt_iff (by linarith)]
  nlinarith

