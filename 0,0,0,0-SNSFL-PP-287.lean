-- The kernel sanitizes all input before it reaches a plugin.
-- F_ext changes B only. P, N, A are structurally unchanged.
-- ============================================================

noncomputable def f_ext_op (s : PNBAState) (δ : ℝ) : PNBAState :=
  { s with B := s.B + δ }

