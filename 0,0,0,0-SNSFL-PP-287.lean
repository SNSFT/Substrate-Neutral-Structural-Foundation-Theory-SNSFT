theorem phase_lock_excludes_shatter (s : PolyvagalState) :
    ¬ (phase_locked s ∧ shatter_event s) := by
  intro ⟨⟨_, hL⟩, ⟨_, hS⟩⟩
  unfold torsion TORSION_LIMIT SOVEREIGN_ANCHOR at *; linarith

