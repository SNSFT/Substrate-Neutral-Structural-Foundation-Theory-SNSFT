  have h4k3 : (4 : ℚ) * k + 3 ≠ 0 := by positivity
  -- Chain: 1/(k+1) + [1/(M+1) + 1/(M(M+1))] = 1/(k+1) + 1/M = 4/(4k+3)
  calc (1 : ℚ) / (k + 1) + 1 / (M + 1) + 1 / (M * (M + 1))
      = 1 / (k + 1) + (1 / (M + 1) + 1 / (M * (M + 1))) := by ring
    _ = 1 / (k + 1) + 1 / M := by
