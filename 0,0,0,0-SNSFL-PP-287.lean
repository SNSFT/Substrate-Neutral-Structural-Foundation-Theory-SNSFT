      have hP_ne : s.P ≠ 0 := ne_of_gt h_full.1
      unfold TORSION_LIMIT SOVEREIGN_ANCHOR; field_simp [hP_ne]; norm_num
  · unfold has_full_pnba
    refine ⟨h_full.1, h_full.2.1, ?_, h_full.2.2.2⟩
