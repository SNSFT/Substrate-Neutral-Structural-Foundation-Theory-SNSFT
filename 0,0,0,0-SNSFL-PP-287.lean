    (hP : kernel_P > 0) (hB : raw_B > 0) (hμ : 0 < μ ∧ μ < 1) :
    kernel_mediated_torsion raw_B kernel_P μ < raw_B / kernel_P := by
  unfold kernel_mediated_torsion
  apply div_lt_div_of_pos_right _ hP
  exact mul_lt_of_lt_one_left hB hμ.2

