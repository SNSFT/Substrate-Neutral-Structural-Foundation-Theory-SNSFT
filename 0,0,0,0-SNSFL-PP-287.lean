     ns_op_N s.N s.im ≤ SOVEREIGN_ANCHOR ∧
     LosslessReduction (0 : ℝ) (manifold_impedance SOVEREIGN_ANCHOR) ∧
     delta_P ≥ SOVEREIGN_ANCHOR) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
