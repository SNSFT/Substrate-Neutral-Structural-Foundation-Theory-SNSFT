theorem tmt_step_is_dynamic_step (s : TMTState) (op : ℝ → ℝ) (F : ℝ) :
    tmt_step s op F = s.P + s.N + op s.B + s.A + F := by
  unfold tmt_step dynamic_rhs pnba_weight; ring

