theorem T9_case_A_closed
    (A : Finset ℕ) (k : ℕ) (hk : k ≥ 3)
    (ε : ℝ) (hε : ε > 0)
    (h_pos : ∀ a ∈ A, 0 < a)
    (h_caseA : is_case_A A ε)
    -- Szemerédi applied to the interval
    (h_szem : ∀ (B : Finset ℕ) (ε' : ℝ) (N : ℕ),
      ε' > 0 → N ≥ 1 →
      (B.filter (fun a => a ≤ N)).card ≥ ε' * N →
      ∃ a d : ℕ, d > 0 ∧ ∀ i < k, (a + i * d) ∈ B) :
    ∃ a d : ℕ, d > 0 ∧ ∀ i < k, (a + i * d) ∈ A := by
