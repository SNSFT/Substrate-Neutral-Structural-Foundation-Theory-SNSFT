theorem kernel_signal_preserves_structure (s : PNBAState) (δ : ℝ) :
    (f_ext_op s δ).P = s.P ∧
    (f_ext_op s δ).N = s.N ∧
    (f_ext_op s δ).A = s.A := by
  unfold f_ext_op; exact ⟨rfl, rfl, rfl⟩

