  s.P > 0 ∧ torsion s < TORSION_LIMIT ∧ s.N ≥ N_THRESHOLD

-- Engagement without meaning: phase locked but N depleted
-- E present but M absent — hollow engagement, false lock
def false_lock (s : PERMAState) : Prop :=
  s.P > 0 ∧ torsion s < TORSION_LIMIT ∧ s.N < N_THRESHOLD

