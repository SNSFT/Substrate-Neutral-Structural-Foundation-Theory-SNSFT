    positivity
  hN := by unfold N_fused4; linarith [e1.hN, e2.hN, e3.hN, e4.hN]
  hB := le_max_left 0 _
  hA := by
    unfold A_fused4
    exact le_trans e1.hA (le_trans (le_max_left e1.A e2.A)
      (le_max_left _ _))

