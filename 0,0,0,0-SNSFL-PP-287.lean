      A        := s.A
      im       := s.im
      pv       := s.pv
      f_anchor := SOVEREIGN_ANCHOR }
  use s'
  constructor
  · unfold sovereign
    refine ⟨rfl, ?_, ?_⟩
    · unfold IVA_dominance; simp only []
      have hP     : s.P > 0 := h_full.1
      have hA     : s.A > 0 := h_full.2.2.2
      have hB_lb  : s.B ≥ TORSION_LIMIT * s.P := by
