theorem threat_raises_torsion (s : PolyvagalState) (δ : ℝ) (hδ : δ > 0) :
    torsion (f_ext_op s δ) > torsion s := by
  unfold torsion f_ext_op; simp
  apply div_lt_div_of_pos_left s.hB s.hP; linarith

