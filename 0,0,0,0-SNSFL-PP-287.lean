theorem sovereign_lossy_exclusive (s : FEState) (F : ℝ) :
    ¬ (IVA_dominance s F ∧ is_lossy s F) := by
  intro ⟨h1, h2⟩; unfold IVA_dominance is_lossy at *; linarith

