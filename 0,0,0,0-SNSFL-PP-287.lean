structure IMSystem where
  im_total : ℝ
  h_pos    : im_total > 0

def im_transfer (source recv : IMSystem) (δ : ℝ) :
    IMSystem × IMSystem :=
  ( { im_total := source.im_total - δ
      h_pos    := by linarith [source.h_pos] }
  , { im_total := recv.im_total + δ
      h_pos    := by linarith [recv.h_pos] } )

