  | N : PNBA  -- [N:VARIABLE] Narrative:  the unknown variable
  | B : PNBA  -- [B:CONSTANT] Behavior:   constant term, behavioral offset
  | A : PNBA  -- [A:SOLVER]   Adaptation: the solving operation

