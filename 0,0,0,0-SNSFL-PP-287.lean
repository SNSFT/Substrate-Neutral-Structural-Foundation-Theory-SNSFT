  | N : PNBA  -- Narrative:  wise mind synthesis, interpersonal thread
  | B : PNBA  -- Behavior:   emotional mind, distress intensity
  | A : PNBA  -- Adaptation: distress tolerance, radical acceptance

def pnba_weight (_ : PNBA) : ℝ := 1

