def IVA_dominance (s : TMTState) (F_ext : ℝ) : Prop :=
  s.A * s.P * s.B ≥ F_ext

def is_lossy (s : TMTState) (F_ext : ℝ) : Prop :=
  F_ext > s.A * s.P * s.B

