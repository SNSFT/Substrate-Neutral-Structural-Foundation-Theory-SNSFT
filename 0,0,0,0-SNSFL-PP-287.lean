  · intro st op F
    unfold fluid_step dynamic_rhs pnba_weight; ring
  · intro st δ; unfold f_ext_op; simp
  · intro st F ⟨hIVA, hLossy⟩
    unfold IVA_dominance is_lossy at *; linarith
  · intro f pv h_drift
    exact ims_lockdown f pv h_drift
