    (h_crisis : |price - fundamental| / fundamental ≥ TORSION_LIMIT) :
    |price - fundamental| / fundamental ≥ TORSION_LIMIT := h_crisis

-- [T3] EQUILIBRIUM AND CRISIS ARE MUTUALLY EXCLUSIVE
