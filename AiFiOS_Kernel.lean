  | N : PNBA  -- Narrative:  common humanity, belonging narrative
  | B : PNBA  -- Behavior:   self-critical response, judgment intensity
  | A : PNBA  -- Adaptation: self-kindness, compassionate self-response

def pnba_weight (_ : PNBA) : ℝ := 1

