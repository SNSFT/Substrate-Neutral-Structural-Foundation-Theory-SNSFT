theorem gamma_sq_identity (v c : ℝ) (hc : c > 0) (hv : v^2 < c^2) :
    (lorentz_factor v c hc hv)^2 * (1 - v^2/c^2) = 1 := by
  have h1 : 1 - v^2/c^2 > 0 := c_is_narrative_limit v c hc hv
  unfold lorentz_factor
  rw [div_pow, one_pow, Real.sq_sqrt h1.le]
