  have hX := mul_div_cancel₀ (e * d - b * f) hD
  have hY := mul_div_cancel₀ (a * f - c * e) hD
  constructor
  · apply mul_left_cancel₀ hD; linear_combination a * hX + b * hY
  · apply mul_left_cancel₀ hD; linear_combination c * hX + d * hY

