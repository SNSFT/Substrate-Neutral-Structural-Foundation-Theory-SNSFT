-- [T112] :: {MASTER} | THE MARGIN EXCEEDS ONE FOR A WARM ENVIRONMENT
theorem t112_margin_gt_one (Tenv Tc : ℝ) (h0 : 0 < Tenv) (h : Tenv < Tc) : 1 < margin Tenv Tc := by
  have hc : 0 < Tc := by linarith
