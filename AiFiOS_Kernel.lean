    (∀ q : ACTState, ¬ (phase_locked q ∧ shatter_event q)) ∧
    -- [10] One ACT response = one dynamic equation application
    (∀ q : ACTState, ∀ op : ℝ → ℝ, ∀ F : ℝ,
