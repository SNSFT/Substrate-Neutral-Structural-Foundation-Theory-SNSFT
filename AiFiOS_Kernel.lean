    ¬ (is_SRIS phi ∧ is_LRIS phi) ∧
    ¬ (is_HRIS phi ∧ is_LRIS phi) := by
  unfold is_HRIS is_SRIS is_LRIS PHI_HIGH PHI_LOW
  refine ⟨?_, ?_, ?_⟩
  · intro ⟨h1, _, h3⟩; linarith
  · intro ⟨⟨h1, _⟩, h3⟩; linarith
  · intro ⟨h1, h3⟩; linarith

