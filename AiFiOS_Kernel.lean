theorem fermi_dirac (x : ℝ) :
    0 < 1 / (Real.exp x + 1) ∧ 1 / (Real.exp x + 1) < 1 ∧
    1 / (Real.exp 0 + 1) = 1 / 2 := by
  have hpos : 0 < Real.exp x + 1 := by positivity
  refine ⟨by positivity, ?_, ?_⟩
  · rw [div_lt_one hpos]
    linarith [Real.exp_pos x]
  · rw [Real.exp_zero]; norm_num

