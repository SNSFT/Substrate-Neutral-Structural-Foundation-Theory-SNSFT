theorem noharm_during_shatter_possible :
    ∃ s : KernelState, shatter_event s ∧ NOHARM s := by
  exact ⟨{ P := 1.0, N := 1.0, B := 2.0, A := 1.0,
            im := 1.0, pv := 0.5, f_anchor := SOVEREIGN_ANCHOR },
