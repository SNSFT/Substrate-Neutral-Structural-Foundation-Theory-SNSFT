theorem release_iff (A b1 b2 : ℝ) (hA : 0 < A) :
    0 < A * b2 - A * b1 ↔ b1 < b2 := by
  constructor
  · intro h
    by_contra hc
    have hle : b2 ≤ b1 := not_lt.mp hc
    nlinarith [mul_le_mul_of_nonneg_left hle hA.le]
  · intro h
    nlinarith

