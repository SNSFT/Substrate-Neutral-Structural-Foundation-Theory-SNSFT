theorem t58_n_max_bracket :
    182.3955 < chain_n_max TORSION_LIMIT TORSION_LIMIT ∧
    chain_n_max TORSION_LIMIT TORSION_LIMIT < 182.3956 ∧
    269.7229 < chain_n_max TL_IVA TL_IVA ∧
