-- ============================================================

def IVA_dominance (s : KernelState) (F_ext : ℝ) : Prop :=
  s.A * s.P * s.B ≥ F_ext

def is_lossy (s : KernelState) (F_ext : ℝ) : Prop :=
  F_ext > s.A * s.P * s.B

