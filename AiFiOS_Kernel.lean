    triple_bout B_UP B_UP B_DOWN = 0 ∧ triple_bout B_UP B_DOWN B_DOWN = 0 := by
  refine ⟨?_, ?_⟩
  · unfold triple_bout B_UP B_DOWN; norm_num [min_def, max_def]
  · unfold triple_bout B_UP B_DOWN; norm_num [min_def, max_def]

-- [T8] A quark can never match a lepton: the lepton carries more
