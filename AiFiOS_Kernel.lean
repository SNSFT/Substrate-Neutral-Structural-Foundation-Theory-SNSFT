-- ============================================================

noncomputable def torsion (s : LocusState) : ℝ := s.B / s.P

def phase_locked (s : LocusState) : Prop :=
  s.P > 0 ∧ torsion s < TORSION_LIMIT

def shatter_event (s : LocusState) : Prop :=
  s.P > 0 ∧ torsion s ≥ TORSION_LIMIT

