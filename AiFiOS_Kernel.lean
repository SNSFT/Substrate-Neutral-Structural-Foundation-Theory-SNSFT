theorem gamma_sq_identity_c2 (v c : ℝ) (hc : c > 0) (hv : v^2 < c^2) :
    (lorentz_factor v c hc hv)^2 * (c^2 - v^2) = c^2 := by
  have hc2 : c^2 ≠ 0 := pow_ne_zero 2 (ne_of_gt hc)
  have hg := gamma_sq_identity v c hc hv
  have e : c^2 * (1 - v^2/c^2) = c^2 - v^2 := by
