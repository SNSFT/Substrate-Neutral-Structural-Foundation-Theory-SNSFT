-- 187 413 635.76…
theorem one_second :
    187413635 < SOVEREIGN_ANCHOR * 1000000000 * TORSION_LIMIT ∧
    SOVEREIGN_ANCHOR * 1000000000 * TORSION_LIMIT < 187413636 := by
  unfold TORSION_LIMIT SOVEREIGN_ANCHOR
  constructor
  · norm_num
  · norm_num

-- ============================================================
-- [9,9,9,9] :: {ANC} | MASTER THEOREM
-- ============================================================

