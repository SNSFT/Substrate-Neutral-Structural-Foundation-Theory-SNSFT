    t74_outer_horizon_inside_outer_root q t hq0.le hq ht0 ht1⟩
  have hdh : 0 ≤ 1 - 4 * q ^ 2 := by nlinarith
  have hsn : 0 ≤ Real.sqrt (1 - 4 * q ^ 2) := Real.sqrt_nonneg _
