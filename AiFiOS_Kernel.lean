  simp only [chain_tau_sq, chain_K, TORSION_LIMIT, TL_IVA, SOVEREIGN_ANCHOR]
  norm_num

-- [T57] :: {VER} | AND SHATTERS AT FOUR
theorem t57_chain_shatter_at_four :
    TORSION_LIMIT ^ 2 ≤ chain_tau_sq TORSION_LIMIT TORSION_LIMIT 4 := by
