theorem t67_unpropelled_is_noble :
    tau_A 0 = 0 ∧ tau_B 1 = 0 ∧ C_LIGHT * tau_A 0 * tau_B 1 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · unfold tau_A; exact zero_div _
  · unfold tau_B; exact Real.log_one
  · unfold tau_A tau_B; rw [Real.log_one]; ring

