-- LAYER 1 — TORSION LAW
-- ============================================================

noncomputable def torsion (s : ProcessingState) : ℝ := s.B / s.P

def phase_locked  (s : ProcessingState) : Prop :=
  s.P > 0 ∧ torsion s < TORSION_LIMIT

def shatter_event (s : ProcessingState) : Prop :=
  s.P > 0 ∧ torsion s ≥ TORSION_LIMIT

