    (hE : bf1.E = bf2.E) (hNr : bf1.Nr = bf2.Nr)
    (hAg_lt : bf1.Ag < bf2.Ag) :
    (bigfive_to_pnba bf1).P < (bigfive_to_pnba bf2).P ∧
