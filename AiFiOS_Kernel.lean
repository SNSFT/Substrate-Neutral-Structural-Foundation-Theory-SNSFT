theorem t28_band_geometric_mean (k a : ℝ) (hk : 0 ≤ k) :
    (Real.sqrt k * a) ^ 2 = (k * a) * a := by
  have hs : Real.sqrt k ^ 2 = k := Real.sq_sqrt hk
  calc (Real.sqrt k * a) ^ 2 = Real.sqrt k ^ 2 * a ^ 2 := by ring
    _ = k * a ^ 2 := by rw [hs]
    _ = (k * a) * a := by ring

