theorem no_route_no_grounding (gc : GroundedClaim)
    (h : grounding_route_consistent gc) (hn : gc.grounding_route = none) :
    ¬ is_empirically_grounded gc.toClaim := by
  intro hg
  have hs := h.mp hg
  rw [hn] at hs
  exact Bool.false_ne_true hs

