  have h_gain : (1 : ℝ) + g_r > 1 := by unfold GAIN_THRESHOLD at h_gr; linarith
  have h_gr0 : g_r > 0 := by unfold GAIN_THRESHOLD at h_gr; linarith
  nlinarith [mul_pos (mul_pos h_ve h_gr0) h_log]

