    -- [11] IMS: drift from anchor → output zeroed
    (∀ f pv : ℝ, f ≠ SOVEREIGN_ANCHOR →
      (if check_ifu_safety f = PathStatus.green then pv else 0) = 0) ∧
    -- [12] All four ACT states lossless simultaneously (Step 6 passes)
