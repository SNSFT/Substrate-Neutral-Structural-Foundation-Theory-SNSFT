  have hm : (Real.sqrt 2 - 1) * (1 + Real.sqrt 2) = 1 := by linear_combination h2
  have hinv : (1 + Real.sqrt 2)⁻¹ = Real.sqrt 2 - 1 := (eq_inv_of_mul_eq_one_left hm).symm
  rw [Real.sinh_eq, Real.exp_neg, Real.exp_log hpos, hinv]
  ring

