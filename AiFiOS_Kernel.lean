  obtain ⟨hlo, hhi⟩ := t19_sqrt_sandwich k h0 h1
  refine ⟨mul_lt_mul_of_pos_right hlo ha, ?_⟩
  calc Real.sqrt k * a < 1 * a := mul_lt_mul_of_pos_right hhi ha
