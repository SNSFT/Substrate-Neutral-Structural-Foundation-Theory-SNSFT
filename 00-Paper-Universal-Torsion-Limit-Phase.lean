-- LAYER 2 — PLUGIN OPERATORS
-- ============================================================

noncomputable def plugin_op_P (P : ℝ) : ℝ := P   -- structure holds
noncomputable def plugin_op_N (_ : ℝ) : ℝ := 0   -- stateless: N = 0
noncomputable def plugin_op_B (B : ℝ) : ℝ := B   -- capability executes
