-- THEOREM 14: ONE SELF-RESPONSE = ONE DYNAMIC EQUATION APPLICATION
theorem sc_step_is_dynamic_step (s : SCState) (op : ℝ → ℝ) (F : ℝ) :
    sc_step s op F = s.P + s.N + op s.B + s.A + F := by
  unfold sc_step dynamic_rhs pnba_weight; ring

