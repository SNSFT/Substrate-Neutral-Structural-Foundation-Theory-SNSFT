    (δP δA : ℝ) (hδP : δP > 0) (hδA : δA > 0) :
    -- [1] Equanimity is true lock (strong P + N, mortality salience doesn't breach τ)
    true_lock equanimity_state ∧
    -- [2] Terror is shatter (mortality salience overwhelms — B/P ≥ limit)
